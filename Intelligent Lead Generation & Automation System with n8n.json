{
  "name": "B2B Lead Research and Outreach Automation",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Lead Machine",
        "formDescription": "Provide the Info Below",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Business Type",
              "placeholder": "e.g. Plumber",
              "requiredField": true
            },
            {
              "fieldLabel": "Location",
              "placeholder": "e.g. Rome, Italy",
              "requiredField": true
            },
            {
              "fieldLabel": "Lead Number",
              "fieldType": "number",
              "requiredField": true
            },
            {
              "fieldLabel": "Email Style",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Friendly"
                  },
                  {
                    "option": "Professional"
                  },
                  {
                    "option": "Simple"
                  }
                ]
              }
            }
          ]
        },
        "options": {
          "appendAttribution": false,
          "buttonLabel": "GO "
        }
      },
      "id": "49a75edf-736f-4054-aea8-8a24c159f27b",
      "name": "On form submission",
      "type": "n8n-nodes-base.formTrigger",
      "position": [
        432,
        336
      ],
      "typeVersion": 2.2
    },
    {
      "parameters": {
        "url": "=https://api.apify.com/v2/acts/YOUR_APIFY_ACTOR_ID/run-sync-get-dataset-items?token={{ $env.APIFY_API_TOKEN }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n    \"includeWebResults\": false,\n    \"language\": \"en\",\n    \"locationQuery\": \"{{ $json.Location }}\",\n    \"maxCrawledPlacesPerSearch\": {{ $json['Lead Number'] }},\n    \"maxImages\": 0,\n    \"maximumLeadsEnrichmentRecords\": 0,\n    \"scrapeContacts\": false,\n    \"scrapeDirectories\": false,\n    \"scrapeImageAuthors\": false,\n    \"scrapePlaceDetailPage\": false,\n    \"scrapeReviewsPersonalData\": true,\n    \"scrapeTableReservationProvider\": false,\n    \"searchStringsArray\": [\n        \"{{ $json['Business Type'] }}\"\n    ],\n    \"skipClosedPlaces\": false\n}",
        "options": {}
      },
      "id": "2294be1e-b7e7-437a-ba31-322bf4c7065f",
      "name": "Run Apify Google Places Actor",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        688,
        336
      ],
      "typeVersion": 4.2
    },
    {
      "parameters": {
        "text": "=Website: {{ $json.website }}",
        "attributes": {
          "attributes": [
            {
              "name": "Email Address",
              "description": "=find out the best only one email address from the website after scraping the website. The mail address have to be in ideal format.",
              "required": true
            }
          ]
        },
        "options": {}
      },
      "id": "571cd0ce-4578-4e7a-8a92-647ef4662d3b",
      "name": "Information Extractor",
      "type": "@n8n/n8n-nodes-langchain.informationExtractor",
      "position": [
        256,
        672
      ],
      "typeVersion": 1.2
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "0906e21a-0958-433e-b400-8694915ef3c9",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              },
              "leftValue": "={{ $json.website }}",
              "rightValue": ""
            }
          ]
        },
        "options": {}
      },
      "id": "f1cc441c-8138-4038-a5bf-b243f830d2ea",
      "name": "Keep Leads With Website",
      "type": "n8n-nodes-base.filter",
      "position": [
        944,
        336
      ],
      "typeVersion": 2.2
    },
    {
      "parameters": {
        "amount": 10
      },
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        608,
        672
      ],
      "id": "1c70d7e5-a879-40c2-86c4-0a5bf289ded9",
      "name": "Rate Limit Delay"
    },
    {
      "parameters": {
        "model": "openai/gpt-3.5-turbo",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "typeVersion": 1,
      "position": [
        336,
        864
      ],
      "id": "2832d20b-24bc-4eb0-9e69-2f3134ddd19f",
      "name": "OpenRouter Model"
    },
    {
      "parameters": {
        "sendTo": "={{ $json['EMAIL ID'] }}",
        "subject": "=A quick idea for {{ $('Keep Leads With Website').item.json.title || 'your team' }}",
        "emailType": "text",
        "message": "=Hi {{ $('Keep Leads With Website').item.json.title || 'there' }},\n\n{{ $('On form submission').first().json['Email Style'] === 'Friendly' ? 'I came across your company while researching businesses in your market and thought I would reach out.' : $('On form submission').first().json['Email Style'] === 'Simple' ? 'I found your company while researching businesses in your market.' : 'I came across your company while researching businesses in your market and wanted to introduce myself.' }}\n\nI help B2B teams reduce repetitive work through practical automation, reliable integrations, and AI-supported workflows.\n\nBased on your public information, I would be happy to share a few relevant automation ideas for your current processes.\n\nWould a brief 15-minute conversation be useful?\n\nBest regards,\n[YOUR NAME]\n[YOUR ROLE / COMPANY]\n[YOUR BOOKING LINK]",
        "options": {
          "appendAttribution": false
        }
      },
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        1120,
        672
      ],
      "id": "4fc714a8-04eb-42ba-bd55-01c85358e7b3",
      "name": "Send Outreach Email"
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "EMAIL ID": "={{ $json.output['Email Address'] }}"
          },
          "matchingColumns": [
            "output"
          ],
          "schema": [
            {
              "id": "EMAIL ID",
              "displayName": "EMAIL ID",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true,
              "removed": false
            }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {}
      },
      "id": "e3f168e5-4330-4ee7-ba4e-52df7d58f120",
      "name": "Append Lead to Google Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "position": [
        896,
        672
      ],
      "typeVersion": 4.6
    },
    {
      "parameters": {
        "content": "B2B LEAD RESEARCH & OUTREACH AUTOMATION\n\nSetup before use:\n1. Set APIFY_API_TOKEN as an n8n environment variable.\n2. Replace YOUR_APIFY_ACTOR_ID with the selected Apify actor ID.\n3. Connect OpenRouter, Google Sheets, and Gmail credentials in n8n.\n4. Replace YOUR_GOOGLE_SHEET_ID and confirm the sheet name.\n5. Replace sender placeholders in the Gmail node.\n6. Test with synthetic data before enabling the workflow.\n\nImportant: Review applicable privacy, anti-spam, and platform rules before contacting leads.",
        "height": 800,
        "width": 1616,
        "color": 3
      },
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        -80,
        272
      ],
      "typeVersion": 1,
      "id": "06ecc131-8b61-4815-8135-0422e18818ee",
      "name": "Sticky Note"
    }
  ],
  "connections": {
